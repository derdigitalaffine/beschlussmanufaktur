# Keine echten Schlüssel in git aufnehmen. Werte mit Python secrets erzeugen.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
SITE_ADDRESS=localhost
APPLICATION_URL=https://localhost
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://localhost
HTTPS_PORT=443
HTTP_PORT=80
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
# Nur für compose.external.yaml: je Schutzbereich eigene Schlüssel und Passwörter.
PROTECTED_SECRET_KEY=
PUBLIC_SECRET_KEY=
PROTECTED_DB_PASSWORD=
PUBLIC_DB_PASSWORD=
PROTECTED_HOST=gremien.localhost
PUBLIC_HOST=info.localhost

# Opt-in transfer; generate a UUID and two different random secrets of at least 32 characters.
EXCHANGE_SOURCE=
EXCHANGE_PROTECTED_KEY=
EXCHANGE_PUBLIC_KEY=
EXCHANGE_PROTECTED_URL=
EXCHANGE_PUBLIC_URL=
# For local Caddy CA, place a trusted CA PEM inside the files volume, e.g. /app/data/exchange-ca.pem.
EXCHANGE_CA_FILE=
EXCHANGE_MAX_AGE=86400

# Optional: interner IMAP-Prüfposteingang, keine automatische Fachübernahme.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_ORGANIZATION=
